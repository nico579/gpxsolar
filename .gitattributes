# Normalisation des fins de ligne — critique pour le build cross-OS.
# Les scripts .sh DOIVENT être en LF, sinon bash casse sur Linux/macOS
# (`$'\r': command not found`). Les .ps1 restent en CRLF (convention Windows).

# Par défaut : détecter le texte et stocker/extraire en LF
* text=auto eol=lf

# Scripts shell, YAML, Python, specs, docs : LF strict
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.py    text eol=lf
*.spec  text eol=lf
*.md    text eol=lf

# Scripts PowerShell : CRLF
*.ps1   text eol=crlf

# Binaires (jamais de normalisation)
*.zip   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.kmz   binary
